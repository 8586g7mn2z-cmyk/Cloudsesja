{
  "name": "diagnos-crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DIAGNOS CRM — panel CRM w przeglądarce",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts && node scripts/build-server.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "seed": "tsx server/src/seed.ts",
    "smtp-test": "tsx scripts/smtp-test-server.ts",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "seed:prod": "node --disable-warning=ExperimentalWarning dist/server/seed.js",
    "zrzuty": "node scripts/zrzuty.cjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.12",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.21.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.77.0",
    "mailparser": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "smtp-server": "^3.21.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
